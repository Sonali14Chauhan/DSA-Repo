Remove all occurrences of a character in a string

Given a string s and a character c. The task is to remove all the occurrences of the character in the string.

Examples:

Input: s = "geeksforgeeks", c = 'e'
Output: s = "gksforgks"
Input: s = "geeksforgeeks", c = 'g'
Output: s = "eeksforeeks"

class Solution {
    // Function to remove all occurrences of the character from the string
    public void removeCharacter(StringBuilder s, char c) {
        // code here
    
        String ans =  remove(s, c, s.length(), 0);
        s.setLength(0);
        s.append(ans);

    }
    
    public String remove(StringBuilder s , char c , int n , int i){
        if(i==n)  return "";
        
        String ans = remove(s, c, n, i+1);
        
        if(s.charAt(i) == c) return ans;
        
        return s.charAt(i) + ans;
    }
}
